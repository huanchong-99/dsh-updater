{
  "name": "dsh-updater",
  "version": "0.3.0",
  "description": "Plugin update panel for DeepSeek Harness (DSH) 0.2.x: scan every profile dependency, classify npm / git-clone / pnpm-git / local-only sources, show outdated status, and run updates from the Settings → Plugins → Updates tab: one click updates everything DSH Plugin Manager installed (through the manager itself), plus git clones and git-hosted installs it cannot update. No third-party plugin dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-updater",
    "auto-update"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huanchong-99/dsh-updater.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.7.0",
    "jsdom": "29.1.1",
    "lightningcss": "1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.7.2",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
